#!name=酷安
#!desc=从墨鱼官方酷安配置转换为原生 Surge 模块；模块跟随上游，响应脚本每 24 小时检查原作者 master 更新。需启用重写、脚本及 MITM，并信任 MITM 证书。
#!author=ddgksf2013
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
#!category=AdBlock
#!raw-url=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/AdBlock/Coolapk.sgmodule

# 上游：https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# 上游版本：V1.0.12；更新时间：2025-09-27
# 上游脚本 SHA256：79b28bcbeb4b7b150a21ed20d7d50d9cee2bb91ff5110e9f34dc3be54b0991e4
# 自动生成，请修改 Surge/scripts/build-coolapk.mjs；遇到不支持的上游语法时停止更新并保留旧版。
# 本文件仅转换原生配置，原作者 JavaScript 仅远程引用，不复制或转载脚本正文。
# 遵守原作者使用限制：仅供学习交流，禁止转载、售卖。
# Map Local 的 text 需要 Surge iOS 5.9.1+ 或 Surge Mac 5.5.1+。

[Map Local]
# > 酷安_屏蔽热词@ddgksf2013
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch data-type=text data="" status-code=200

[Script]
# > 酷安_开屏广告@ddgksf2013
coolapk_response_01 = type=http-response,pattern=^https?:\/\/api.coolapk.com\/v6\/main\/init,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# > 酷安_推广广告@ddgksf2013
coolapk_response_02 = type=http-response,pattern=^https?:\/\/api.coolapk.com\/v6\/dataList,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# > 酷安_首页广告@ddgksf2013
coolapk_response_03 = type=http-response,pattern=^https?:\/\/api.coolapk.com\/v6\/main\/indexV8,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# > 酷安_评论广告@ddgksf2013
coolapk_response_04 = type=http-response,pattern=^https?:\/\/api.coolapk.com\/v6\/feed\/replyList,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# > 酷安_商品推广@ddgksf2013
coolapk_response_05 = type=http-response,pattern=^https?:\/\/api.coolapk.com\/v6\/feed\/detail,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js
# > 酷安_酷品页推广@ddgksf2013
coolapk_response_06 = type=http-response,pattern=https://api.coolapk.com/v6/page/dataList\?.*title=%E9%85,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

[MITM]
hostname = %APPEND% api.coolapk.com
