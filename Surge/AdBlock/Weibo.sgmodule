#!name=微博
#!desc=墨鱼微博及轻享版完整上游精简版；包含上游皮肤状态及视频预览相关响应修改，不是账号会员开通。每 6 小时检查上游，远程脚本每 24 小时检查更新。需 Surge iOS 5.14+ 或 Mac 5.9+（原生 JQ），启用重写、脚本及 MITM 并信任证书。
#!author=ddgksf2013, zmqcherish, shiro
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/WeiboAds.conf
#!category=AdBlock
#!raw-url=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/AdBlock/Weibo.sgmodule

# 上游：https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/WeiboAds.conf
# 上游版本：V2.0.114
# 上游规则 SHA256：9cc47e68231ae05324f50eea108e0f1e5175fa2cfeeb6c8bae241db1556b038a
# 自动生成，请修改 Surge/scripts/build-weibo.mjs；未知语法或范围变化停止更新并保留旧版。
# 作者署名和引用出处按原作者声明保留；远程脚本直接引用原作者 master 分支，不复制正文。
# 忠实完整转换：保留原上游全部规则和 MITM；不额外制作或修改 JavaScript，不扩大原规则功能。
# 上游净化可能改变发现页、热搜/推荐流、个人页组件；包含皮肤状态及视频预览相关响应修改，不是账号会员开通。
# 原生 JQ Body Rewrite 需要 Surge iOS 5.14+ 或 Surge Mac 5.9+；未在手机实机验证。

[Rule]
# > 微博_分流@ddgksf2013
DOMAIN,sdkapp.uve.weibo.com,DIRECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
# > 微博国际版_开屏拦截@ddgksf2013
DOMAIN-SUFFIX,api.touch-moblie.com,REJECT

[URL Rewrite]
# > 微博_应用内弹窗广告@ddgksf2013
^https?:\/\/(preload-click|preload-impression)\.uve\.weibo\.com\/(interface\/wbpullad\/wbpullad_click\.php|wbapplua\/get_wbpullad_log\.lua) - reject
# > 微博_屏蔽sdkconfig请求@ddgksf2013
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkconfig\.php - reject

[Map Local]
# > 微博_首页信息流可能感兴趣推广@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_positive data-type=text data="" status-code=200
# > 微博_首页顶部弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/push\/info data-type=text data="" status-code=200
# > 微博_启动感兴趣弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*account\/recommend_interesttags data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_首页顶部直播推荐Tab@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*\/media_homelist data-type=text data="" status-code=200
# > 微博_搜索页默认填充词@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*finder\/searchbarchange data-type=text data="" status-code=200
# > 微博_AD_Preload@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/ad\/preload data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_用户推荐弹窗@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/profile\/recommend_popuser data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_每日一次的开屏广告请求@ddgksf2013
^https?:\/\/boot.*weibo\.com\/v\d\/ad\/realtime data-type=text data="" status-code=200
# > 微博_去除底部超话栏表层浮icon及tips@ddgksf2013
^https?:\/\/api\.weibo\.cn\/.*discovery_home_bottom_getdotinfo data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_屏蔽首页左上角每日的弹窗tips@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d/push/daily data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博_Spotlight@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/hot\/hours_spotlight data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_趋势页热门影片@ddgksf2013
^https?:\/\/api\.weibo\.cn\/\d\/cardlist\?v_f=.*Weibo_intl data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_屏蔽hotsearch@ddgksf2013
^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php\?a=hot_search_users data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# > 微博国际版_屏蔽热推荐@ddgksf2013
^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/ad\/weibointl\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
# > 微博_删除侧栏视频流@ddgksf2013
http-response-jq ^https?:\/\/api\.weibo\.cn\/\d\/ug\/checkin\/stream '.items |= map(select(.category != "card"))'

[Script]
# > 微博_详情页及评论区@ddgksf2013
weibo_response_01 = type=http-response,pattern=^https?:\/\/api\.weibo\.cn\/\d\/statuses\/container_detail,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_首页顶部homeExtend@ddgksf2013
weibo_response_02 = type=http-response,pattern=^https?:\/\/api\.weibo\.cn\/\d\/groups\/allgroups\/v\d,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_开屏广告预加载处理@ddgksf2013
weibo_response_03 = type=http-response,pattern=^https?:\/\/boot.*weibo\.com\/v\d\/ad\/preload,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_未登陆状态下首页信息流处理@ddgksf2013
weibo_response_04 = type=http-response,pattern=^https?:\/\/api\.weibo\.cn\/\d\/\w{5}\/(statuses_unread_hot_timeline|timeline),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_视频信息处理@ddgksf2013
weibo_response_05 = type=http-response,pattern=^https?:\/\/api\.weibo\.cn\/\d\/video\/tiny_stream_mid_detail,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_屏蔽发现页面搜索框热词@ddgksf2013
weibo_response_06 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/\w{5}\/cardlist,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_自定义tab皮肤@zmqcherish
weibo_response_07 = type=http-response,pattern=^https://api.weibo.cn/2/!/client/light_skin,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_非会员设置tab皮肤@zmqcherish
weibo_response_08 = type=http-response,pattern=^https://new.vip.weibo.cn/littleskin/preview,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博_去广告以及去除各部分推广模块@zmqcherish,@ddgksf2013
weibo_response_09 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(searchall|page\?|0flowpage),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_10 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(unread_)?friends(/|_)timeline,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_11 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/groups/timeline,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_12 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/statuses/(container_timeline|unread_hot_timeline|extend|video_mixtimeline|unread_topic_timeline),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_13 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/profile/(me|container_timeline),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_14 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/video/(community_tab|remind_info|tiny_stream_video_list),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_15 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/search/(finder|container_timeline|container_discover),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_16 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/(checkin/show|\!/live/media_homelist|container/get_item),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
weibo_response_17 = type=http-response,pattern=^https?:\/\/m?api\.weibo\.c(n|om)\/\d\/cardlist,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_帖子下方广告banner@ddgksf2013
weibo_response_18 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=open_app,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_屏蔽searching_info@shiro
weibo_response_19 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=get_searching_info,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_search_info.json
# > 微博国际版_屏蔽search_topic@shiro
weibo_response_20 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*feed&a=search_topic,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_search_topic.json
# > 微博国际版_屏蔽开屏广告@ddgksf2013
weibo_response_21 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*get_coopen_ads,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_屏蔽sdkad@ddgksf2013
weibo_response_22 = type=http-response,pattern=^https?://(sdk|wb)app\.uve\.weibo\.com(/interface/sdk/sdkad.php|/wbapplua/wbpullad.lua),requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_趋势顶部Card去广告@ddgksf2013
weibo_response_23 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.c(n|om)\/portal\.php.*a=trends,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_屏蔽用户VIP栏@ddgksf2013
weibo_response_24 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=user_center,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js
# > 微博国际版_热搜处理@ddgksf2013
weibo_response_25 = type=http-response,pattern=^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=search_topic,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/weibo_json.js

[MITM]
hostname = %APPEND% api.weibo.*, *.api.weibo.*, mapi.weibo.*, *.uve.weibo.com, new.vip.weibo.cn, boot.biz.weibo.com
