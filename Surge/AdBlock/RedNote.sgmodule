rednote_response_15 = type=http-response,pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed\/categories,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://ddgksf2013.top/scripts/redbook.ads.js
rednote_response_16 = type=http-response,pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://ddgksf2013.top/scripts/redbook.ads.js

[MITM]
hostname = %APPEND% *.xiaohongshu.com
