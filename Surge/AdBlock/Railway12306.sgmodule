#!name=铁路12306（开屏去广告）
#!desc=铁路12306开屏及广告接口专用版：仅处理 ad.12306.cn/ad/ser/getAdList，在请求阶段按上游脚本返回开屏广告占位或空广告结果，并保留该广告域名 DIRECT 分流；不改写其他购票、订单或支付接口。原作者 ddgksf2013；规则每 6 小时检查上游，请求脚本每 24 小时检查原作者分支更新。建议使用最新版 Surge；需开启脚本、MITM，并安装及信任 MITM 证书。不代表所有版本的全部广告都能去除；若影响使用请停用，尚未在最新版 App 实机验证。
#!author=ddgksf2013
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/12306.js
#!category=AdBlock
#!raw-url=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/AdBlock/Railway12306.sgmodule

# 上游：https://raw.githubusercontent.com/ddgksf2013/Scripts/master/12306.js
# 上游版本：2024-08-24
# 上游规则 SHA256：4723bc2236835eea0a8b79529c832a9af1cfd37fa1b160becb3a4b51f9067cd5
# 自动生成，请修改 Surge/scripts/build-railway12306.mjs；遇到不支持的上游语法时停止更新并保留旧版。
# 上游 script-analyze-echo-response 在请求阶段直接返回广告占位响应，故转换为 http-request。

[Rule]
DOMAIN,ad.12306.cn,DIRECT

[Script]
railway12306_request_01 = type=http-request,pattern=^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList,requires-body=true,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/12306.js

[MITM]
hostname = %APPEND% ad.12306.cn
