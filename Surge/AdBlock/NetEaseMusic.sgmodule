netease_music_response_05 = type=http-response,pattern=^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/default\/keyword\/list,requires-body=true,binary-body-mode=true,engine=webview,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/NetEaseMusic.js
