#!name=网易云音乐
#!desc=从墨鱼官方网易云音乐规则自动转换；每 6 小时同步规则和兼容脚本，Surge 每 24 小时检查脚本更新。需启用重写、脚本及 MITM，并信任 MITM 证书；仅广告净化，不解锁会员或音乐版权。
#!author=ddgksf2013
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/NeteaseAds.conf
#!category=AdBlock
#!raw-url=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/AdBlock/NetEaseMusic.sgmodule

# 上游配置：https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/NeteaseAds.conf
# 上游脚本：https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js
# 上游版本：V1.0.33
# 上游规则 SHA256：3d09d41ed78536e091612afd10fc471455ae82b274bbbf2f0b37399078e1677b
# 上游脚本 SHA256：6ba468eb994e3843d69563f8f3b31c2d63a62a68d60fc3a1fd61947c1546936f
# 自动生成，请修改 Surge/scripts/build-netease-music.mjs；未知语法停止更新并保留旧版。
# 原作者脚本使用加密二进制响应，已启用 binary-body-mode；只添加 IIFE 兼容外层。
# gzip 分支使用 TextEncoder，必须运行在 WebView 引擎；旧 macOS 10.15 及更早版本、tvOS 的纯 JSC 环境不支持。
# 引用按上游 @Attention 保留出处；兼容脚本头部保留原文并附 CryptoJS/pako/zlib 许可。
# 原作者提示：默认不去除底部“漫游”，可在侧栏设置中手动关闭。
# Map Local 的 text 需要 Surge iOS 5.9.1+ 或 Surge Mac 5.5.1+。

[Map Local]
# > 活动推广@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list data-type=text data="" status-code=200
# > 启动领VIP弹窗@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query data-type=text data="" status-code=200
# > 优惠券@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get data-type=text data="" status-code=200
# > 活动推广@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity data-type=text data="" status-code=200
# > 评论区插入推广@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources data-type=text data="" status-code=200
# > 购买实体专辑@ddgksf2013
^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/resource-exposure\/config data-type=text data="" status-code=200

[Script]
# > 底部Tab@ddgksf2013
netease_music_response_01 = type=http-response,pattern=^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/home\/framework\/tab,requires-body=true,binary-body-mode=true,engine=webview,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/NetEaseMusic.js
# > 发现页@ddgksf2013
netease_music_response_02 = type=http-response,pattern=^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show,requires-body=true,binary-body-mode=true,engine=webview,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/NetEaseMusic.js
# > 首推荐页@ddgksf2013
netease_music_response_03 = type=http-response,pattern=^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/rcmd\/resource\/show,requires-body=true,binary-body-mode=true,engine=webview,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/NetEaseMusic.js
# > 软件更新@ddgksf2013
netease_music_response_04 = type=http-response,pattern=^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ios\/upgrade\/get,requires-body=true,binary-body-mode=true,engine=webview,max-size=-1,timeout=60,script-update-interval=86400,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/NetEaseMusic.js
