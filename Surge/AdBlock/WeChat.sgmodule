#!name=微信（公众号推广与部分小程序去广告）
#!desc=处理公众号带货与相关搜索词，便利蜂、顺丰、掌上公交，以及全家横幅、EMS广告模块、COCO背景/底部横幅、青桔横幅。新增四项可独立关闭；公众号广告字段清理是默认关闭的兼容性实验，需手动开启并在手机验收。保留四条本地响应和公交正文重写，新增五个精确目标由本仓库独立响应脚本处理，异常或未知结构原样放行，保留其他原文字节和大整数。每6小时检查已审核来源；本仓库脚本每24小时检查更新，不下载可莉或Belcheck脚本。需Surge iOS 5.10+ / Mac 5.6+，开启重写、脚本与MITM并信任证书。不处理朋友圈、视频号或全部小程序5秒开屏；未手机实测。
#!author=ddgksf2013（基础规则）；wch19830910（独立扩展）；可莉 / QingRex、NobyDa / Belcheck（行为与接口参考）
#!category=AdBlock
#!homepage=https://github.com/ddgksf2013/Rewrite
#!raw-url=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/AdBlock/WeChat.sgmodule
#!arguments=familyMart:true,ems:true,coco:true,qingju:true,officialAccountExperimental:false
#!arguments-desc=familyMart=全家横幅；ems=EMS广告模块；coco=COCO背景与横幅；qingju=青桔横幅（四项默认true，可填false关闭）。officialAccountExperimental=公众号广告字段兼容性实验，默认false；填true仅尝试清理已识别响应，尚未手机验证。

# 原作者：ddgksf2013 / 墨鱼；兼容整理日期：2026-10-26。
# 来源署名及限制：https://github.com/wch19830910/wch/blob/main/Surge/licenses/ddgksf2013-WeChat-NOTICE.txt
# 去开屏来源：https://ddgksf2013.top/rewrite/StartUpAds.conf
# 小程序来源：https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/Applet.conf
# 公交行为参考：https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/zhangshanggongjiao.js（仅静态审查，不发布原脚本）
# 小程序接口参考：https://raw.githubusercontent.com/QingRex/LoonKissSurge/main/Surge/Beta/%E5%BE%AE%E4%BF%A1%E5%B0%8F%E7%A8%8B%E5%BA%8F%E5%8E%BB%E5%B9%BF%E5%91%8A.beta.sgmodule（不复制其脚本实现）
# 公众号接口线索：NobyDa；数据保留设计参考：https://github.com/belcheckyoung/Belcheck-QX-AdBlock/blob/main/Docs/WeChatAdClean.md
# 来源SHA256：startup=9a3443554fe38d94c1b65d648c89f408c87574c674d4a7f4550c758d5d75639b；applet=6259647585e993f4b28897e8cba3b96366a775ed8f897b87d6cf8547e7ae28f0；bus=0a2ebfbf41ed4b7dbd39f4aa50616ac42cd59d5eb0baa026fc1b98e7a4f5a8bb；miniPrograms=20a50ebaba240046aa550688eaf56781021f4bc9c5e1e47883a48164ad75719c
# 自动生成；显示名称和说明请修改 Surge/scripts/build-wechat.mjs，直接改成品会被同步覆盖。
# 原五个目标保留；新增四个小程序目标和一个默认关闭的公众号实验，合计八个精确MITM主机；没有整域拒绝、会员或隐藏内容处理。
# 公交仅将完整JSON键 Ad / Ad_ab 的数字1改为0；保留10、其他键、字符串和未知字段。
# 不启用旧 getappmsgad 字符串替换、WeChat110 或 WordPress 通用脚本；公众号新实验默认透传，参考记录见 Surge/upstream/WeChat.sources.json。
# 下载、解析或范围验证失败时不发布新成品。

[Map Local]
# 公众号带货商品信息
^https?:\/\/mp\.weixin\.qq\.com\/mp\/cps_product_info(?:\?|$) data-type=text data="" status-code=200
# 公众号相关搜索词
^https?:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword(?:\?|$) data-type=text data="" status-code=200
# 便利蜂小程序横幅
^https?:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+$ data-type=text data="" status-code=200
# 顺丰速运小程序信息流广告
^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query$ data-type=text data="" status-code=200

[Body Rewrite]
http-response ^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do(?:\?|$) (?<!\\)\x22Ad\x22\s*:\s*1(?=\s*[,}]) "\"Ad\":0" (?<!\\)\x22Ad_ab\x22\s*:\s*1(?=\s*[,}]) "\"Ad_ab\":0"

[Script]
WeChat_Selected = type=http-response,pattern=^https:\/\/(?:minifm\.maxxipoint\.com\/banner\/list(?:\?[^#]*)?|ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel(?:\?[^#]*)?|coco-com\.e\.verystar\.net\/v1\/home\/info(?:\?[^#]*)?|htwkop\.xiaojukeji\.com\/gateway\?(?:[^#&]*&)*api=hm\.fa\.homeConfig(?:&[^#]*)?|mp\.weixin\.qq\.com\/mp\/getappmsgad(?:\?[^#]*)?)$,requires-body=true,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/wch19830910/wch/main/Surge/Script/WeChat.js,script-update-interval=86400,argument="familyMart={{{familyMart}}},ems={{{ems}}},coco={{{coco}}},qingju={{{qingju}}},officialAccountExperimental={{{officialAccountExperimental}}}"

[MITM]
hostname = %APPEND% mp.weixin.qq.com, api.blibee.com, ucmp.sf-express.com, wx.mygolbs.com, minifm.maxxipoint.com, ump.ems.com.cn, coco-com.e.verystar.net, htwkop.xiaojukeji.com
